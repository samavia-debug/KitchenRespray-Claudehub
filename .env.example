# Copy this file's variable names into Vercel's Environment Variables settings.
# Get these values from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Settings -> API -> service_role). Server-only — used for
# privileged writes (admin user management, Canva tokens, website monitoring
# writes). NEVER put this in a NEXT_PUBLIC_ variable or expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Get this from console.anthropic.com -> API Keys
# NEVER put this in a NEXT_PUBLIC_ variable - it must stay server-side only
ANTHROPIC_API_KEY=

# Canva OAuth app credentials (Canva Developer Portal). Server-only.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Random secret shared with Vercel Cron so /api/monitoring/cron can't be
# triggered by anyone else. Vercel sets the "Authorization: Bearer <value>"
# header automatically when this env var is present. Generate with e.g.
# `openssl rand -hex 32`.
CRON_SECRET=

# Slack Incoming Webhook URL for incident open/resolved notifications.
# Slack -> Apps -> Incoming Webhooks -> Add to Slack -> pick a channel ->
# copy the webhook URL. Optional — notifications are silently skipped
# (not an error) when this isn't set.
SLACK_WEBHOOK_URL=
